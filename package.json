{
	"name": "wordpress-starter",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && vite build --ssr",
		"ssr": "pm2 start ecosystem.config.cjs",
		"ssr:stop": "pm2 stop ecosystem.config.cjs",
		"ssr:restart": "pm2 restart ecosystem.config.cjs",
		"lint": "eslint \"wp-content/themes/inertia/resources/Private/js/**/*.{js,ts,vue}\"",
		"lint:fix": "eslint \"wp-content/themes/inertia/resources/Private/js/**/*.{js,ts,vue}\" --fix",
		"format": "prettier --ignore-path .prettierignore --write \"wp-content/themes/inertia/**/*.{js,ts,vue,css,postcss,php,json,md,yml,yaml}\" \"config.ts\" \"vite.config.ts\" \"tsconfig.json\"",
		"format:check": "prettier --ignore-path .prettierignore --check \"wp-content/themes/inertia/**/*.{js,ts,vue,css,postcss,php,json,md,yml,yaml}\" \"config.ts\" \"vite.config.ts\" \"tsconfig.json\"",
		"typecheck": "tsc --noEmit && vue-tsc --noEmit",
		"audit": "npm audit",
		"test:frontend": "node --test tests/frontend/*.test.mjs",
		"test:e2e": "playwright test --config tests/e2e/playwright.config.mjs",
		"test:forms": "npm run test:frontend && ddev wp eval-file scripts/checks/gravity-forms.php && npm run test:e2e -- --project=forms",
		"test:project": "npm run lint && npm run typecheck && npm run test:frontend && ddev wp eval-file scripts/checks/starter.php && ddev wp eval-file scripts/checks/wpml-compatibility.php && ddev wp eval-file scripts/checks/gravity-forms.php && sh scripts/checks/public-paths.sh \"${E2E_BASE_URL:-https://wordpress-starter.ddev.site}\" && npm run test:e2e",
		"preview:forms": "node tests/frontend/preview.mjs"
	},
	"dependencies": {
		"@inertiajs/core": "^3.11.0",
		"@inertiajs/vue3": "^3.11.0",
		"@primeuix/themes": "^3.1.1",
		"@vueuse/core": "^15.0.0",
		"gsap": "^3.15.1",
		"primevue": "^5.0.5",
		"vanilla-lazyload": "^19.1.3",
		"vue": "^3.5.46",
		"vue-i18n": "^11.4.23"
	},
	"devDependencies": {
		"@peterek/vite-plugin-favicons": "^2.1.0",
		"@playwright/test": "^1.65.1",
		"@prettier/plugin-php": "^0.26.0",
		"@spiriit/vite-plugin-svg-spritemap": "^7.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-vue": "^6.0.11",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/server-renderer": "^3.5.46",
		"@zackad/prettier-plugin-twig": "^0.18.0",
		"eslint": "^10.15.0",
		"eslint-plugin-vue": "^10.12.1",
		"globals": "^17.14.0",
		"pm2": "^7.1.2",
		"prettier": "^3.10.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svgo": "^4.1.0",
		"tailwindcss": "^4.3.5",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-native": "npm:typescript@^7.0.2",
		"vite": "^8.3.8",
		"vite-plugin-mkcert": "^2.1.0",
		"vue-tsc": "^3.3.14",
		"wordpress-vite-plugin": "^1.6.0"
	},
	"engines": {
		"node": ">=26.13.1 <27"
	},
	"overrides": {
		"pm2": {
			"js-yaml": "^4.3.2"
		},
		"@tailwindcss/typography": {
			"postcss-selector-parser": "^6.1.6"
		}
	}
}
