{
	"name": "wordpress-starter",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && vite build --ssr",
		"ssr": "pm2 start ecosystem.config.cjs",
		"ssr:stop": "pm2 stop ecosystem.config.cjs",
		"ssr:restart": "pm2 restart ecosystem.config.cjs",
		"lint": "eslint \"wp-content/themes/inertia/resources/Private/js/**/*.{js,ts,vue}\"",
		"lint:fix": "eslint \"wp-content/themes/inertia/resources/Private/js/**/*.{js,ts,vue}\" --fix",
		"format": "prettier --ignore-path .prettierignore --write \"wp-content/themes/inertia/**/*.{js,ts,vue,css,postcss,php,json,md,yml,yaml}\" \"config.ts\" \"vite.config.ts\" \"tsconfig.json\"",
		"format:check": "prettier --ignore-path .prettierignore --check \"wp-content/themes/inertia/**/*.{js,ts,vue,css,postcss,php,json,md,yml,yaml}\" \"config.ts\" \"vite.config.ts\" \"tsconfig.json\""
	},
	"dependencies": {
		"@evo-mark/inertia-wordpress": "file:wp-content/plugins/inertia-wordpress/resources/plugins",
		"@inertiajs/vue3": "^3.0.3",
		"@primeuix/themes": "^2.0.3",
		"@primevue/themes": "^4.5.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@vitejs/plugin-vue": "^6.0.6",
		"@vueuse/core": "^14.2.1",
		"primevue": "^4.5.5",
		"tailwindcss": "^4.2.2",
		"vanilla-lazyload": "^19.1.3",
		"vite": "^8.0.8",
		"vue": "^3.5.32",
		"vue-i18n": "^11.3.2",
		"vue-scrollto": "^2.20.0",
		"wordpress-vite-plugin": "^1.6.0"
	},
	"devDependencies": {
		"@peterek/vite-plugin-favicons": "^2.1.0",
		"@prettier/plugin-php": "^0.25.0",
		"@spiriit/vite-plugin-svg-spritemap": "^7.0.0",
		"@types/node": "^25.6.0",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"@vue/eslint-config-airbnb": "^7.0.1",
		"@vue/eslint-config-typescript": "^11.0.3",
		"@vue/server-renderer": "^3.5.32",
		"@zackad/prettier-plugin-twig": "^0.17.0",
		"eslint": "^8.57.1",
		"eslint-plugin-vue": "^9.33.0",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svgo": "^4.0.1",
		"typescript": "^5.8.3",
		"vite-plugin-mkcert": "^2.0.0"
	}
}
