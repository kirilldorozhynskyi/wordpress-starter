{
	"name": "justdev/wordpress-starter",
	"type": "project",
	"description": "jD WordPress starter",
	"homepage": "https://justdev.org",
	"license": "MIT",
	"keywords": [
		"WordPress",
		"Starter"
	],
	"version": "4.2.2",
	"require": {
		"php": ">=8.1",
		"composer/installers": "^2.3",
		"roots/wordpress": "^6.9.4",
		"vlucas/phpdotenv": "^5.6.3",
		"oscarotero/env": "^2.1.1",
		"roots/wp-config": "1.0.0",
		"ext-json": "*",
		"yahnis-elsts/plugin-update-checker": "^5.6",
		"timber/timber": "^2.3.3",
		"roots/bedrock-autoloader": "^1.1.0",
		"wpengine/advanced-custom-fields-pro": "*",
		"yoast/wordpress-seo": "^27.4",
		"justdev/jd-support": "^2.1.4",
		"pronamic/gravityforms": "^2.9.31",
		"evo-mark/inertia-wordpress": "^0.8.5",
		"ilab/ilab-media-tools": "^4.6.4",
		"kirilldorozhynskyi/jd-wp-sync-db": "*",
		"kirilldorozhynskyi/jd-wp-sync-db-media-files": "*",
		"kirilldorozhynskyi/wp-stage-switcher": "^2.2.1",
		"wpackagist-plugin/wp-mail-smtp": "^4.7.1",
		"wpackagist-plugin/redirection": "^5.7.5",
		"wpackagist-plugin/ewww-image-optimizer": "^8.5.0",
		"wpackagist-plugin/simple-custom-post-order": "^2.6.0",
		"wpackagist-plugin/query-monitor": "^4.0.6",
		"wpackagist-plugin/duplicate-post": "^4.6"
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*",
				"wpackagist-theme/*"
			]
		},
		{
			"type": "vcs",
			"url": "git@github.com:kirilldorozhynskyi/wp-stage-switcher.git",
			"branch": "master"
		},
		{
			"type": "vcs",
			"url": "git@github.com:kirilldorozhynskyi/jd-wp-sync-db.git",
			"branch": "master"
		},
		{
			"type": "vcs",
			"url": "git@github.com:kirilldorozhynskyi/jd-wp-sync-db-media-files.git",
			"branch": "master"
		},
		{
			"type": "vcs",
			"url": "git@github.com:kirilldorozhynskyi/cm-gdpr-cookie-consent",
			"branch": "master"
		},
		{
			"type": "vcs",
			"url": "git@github.com:pronamic/gravityforms.git",
			"branch": "master"
		},

		{
			"type": "composer",
			"url": "https://connect.advancedcustomfields.com"
		}
	],
	"extra": {
		"installer-paths": {
			"wp-content/mu-plugins/{$name}/": [
				"type:wordpress-muplugin"
			],
			"wp-content/plugins/{$name}/": [
				"type:wordpress-plugin"
			],
			"wp-content/themes/{$name}/": [
				"type:wordpress-theme"
			]
		},
		"wordpress-install-dir": "vendor/wordpress-core"
	},
	"autoload": {
		"psr-4": {
			"JDEV\\": "wp-content/themes/template/classes",
			"JDEVINT\\": "scripts/",
			"Inertia\\RestApi\\": "wp-content/themes/inertia/rest-api/",
			"InertiaTheme\\": "wp-content/themes/inertia/classes/"
		}
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.11.3",
		"roave/security-advisories": "dev-latest"
	},
	"config": {
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"allow-plugins": {
			"composer/installers": true,
			"roots/wordpress-core-installer": true,
			"pivvenit/acf-pro-installer": true,
			"ffraenz/private-composer-installer": true
		}
	},
	"scripts": {
		"post-create-project-cmd": [
			"JDEVINT\\Installer::create",
			"@install"
		],
		"wp-vite-install-deps": [
			"composer install --working-dir=wp-content/plugins/wp-vite --no-dev --optimize-autoloader"
		],
		"post-install-cmd": [
			"JDEVINT\\Installer::install",
			"rsync -av --exclude='.git' vendor/wordpress-core/ ./",
			"rm -rf vendor/wordpress-core/",
			"@wp-vite-install-deps"
		],
		"post-update-cmd": [
			"rsync -av --exclude='.git' vendor/wordpress-core/ ./",
			"rm -rf vendor/wordpress-core/",
			"@wp-vite-install-deps"
		],
		"install": [
			"git init -b master",
			"git add .",
			"git commit -m'[INT] Starter initial'",
			"cd wp-content/themes/template && npm i"
		]
	}
}
